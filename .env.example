# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# .env sẽ được tự nạp khi chạy các script (qua env.js). ĐỪNG commit .env lên git.

# Cảnh báo Telegram (bắt buộc nếu muốn nhận thông báo)
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# RPC cho Cách C (track-ws.js / backtest-c.js). Mặc định dùng RPC công khai (rate-limit).
# Dùng wss:// nếu có provider riêng để real-time nhanh hơn.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# (khuyên dùng) nhiều RPC miễn phí, cách nhau dấu phẩy -> tự failover khi 1 cái chết.
# RPC_URLS ưu tiên hơn RPC_URL. Chạy `node test/test-rpcs.js` để kiểm tra trước khi dùng.
# Đã test (2026-08): official + tenderly OK (getLogs cả full-history);
#   publicnode CHẶN getLogs (cần token allnodes); ArrowRPC đang chết (530).
RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-chain.gateway.tenderly.co

# (tuỳ chọn) track-ws.js chờ N block trước tip để tránh reorg (mặc định 5)
CONFIRMATIONS=5
