# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# .env sẽ được tự nạp khi chạy các script (qua env.js). ĐỪNG commit .env lên git.

# Cảnh báo Telegram (bắt buộc nếu muốn nhận thông báo)
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# RPC cho Cách C (track-ws.js / backtest-c.js). Mặc định dùng RPC công khai (rate-limit).
# Dùng wss:// nếu có provider riêng để real-time nhanh hơn.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# (khuyên dùng) nhiều RPC miễn phí, cách nhau dấu phẩy -> tự failover khi 1 cái chết.
# RPC_URLS ưu tiên hơn RPC_URL. Chạy `node test/test-rpcs.js` để kiểm tra trước khi dùng.
# Đã test (2026-08):
#   - official + tenderly: OK, getLogs cả full-history (nhận nguyên range 45M block/1 call).
#   - publicnode: CHẶN getLogs address-less (đòi `address`) -> KHÔNG quét được adapter, ĐỪNG dùng.
#   - Alchemy free: getLogs chỉ 10 block/lần -> chỉ hợp quét LIVE (bộ chia tự cắt nhỏ),
#       KHÔNG hợp nạp lịch sử; muốn nới phải lên PAYG. Có thể thêm làm RPC dự phòng thứ 3.
#   - ArrowRPC: đang chết (530).
RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-chain.gateway.tenderly.co

# (tuỳ chọn) Alchemy làm RPC thứ 3 — dán URL có API key của bạn vào CUỐI RPC_URLS ở trên, ví dụ:
#   RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-chain.gateway.tenderly.co,wss://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
# Lưu ý free tier giới hạn getLogs 10 block/lần (xem trên). Kiểm tra: ALCHEMY_URL=<url> node test/test-rpcs.js

# (tuỳ chọn) track-ws.js chờ N block trước tip để tránh reorg (mặc định 5)
CONFIRMATIONS=5

# (tuỳ chọn) PUSH 0-conf (báo sớm 2 nấc): nếu RPC_URLS có 1 URL wss:// (hoặc đặt WS_URL riêng),
# track-ws mở eth_subscribe -> gửi thẻ "⚡ CHỜ XÁC NHẬN" ngay, rồi vòng poll edit thành "✅ đã xác nhận"
# (hoặc "⚠️ reorg" nếu biến mất). Push chỉ tối ưu độ trễ; poll VẪN là nguồn chân lý. Không có wss -> tắt push.
# WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>

# (tuỳ chọn) nguồn log DỰ PHÒNG độc lập khi mọi RPC chết (mặc định Blockscout công khai)
# BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com
# (tuỳ chọn) trần số call khi chia nhỏ getLogs cho RPC giới hạn range chặt (mặc định 4000)
# LOG_SPLIT_BUDGET=4000

# ============================================================================
# Bot 2 — track-index.js: canh khi THEINDEX tích hợp POOLS.TRADE + bắt token index đầu tiên
# ============================================================================
# BẮT BUỘC dùng Telegram bot token RIÊNG (khác rh-tracker) — Telegram getUpdates độc quyền,
# chạy 2 tracker cùng 1 token sẽ lỗi 409. Chat ID có thể trùng.
INDEX_TELEGRAM_BOT_TOKEN=123456789:AA-bot-token-KHAC-tu-BotFather
INDEX_TELEGRAM_CHAT_ID=123456789
# (tuỳ chọn) chu kỳ quét (ms) — tích hợp là sự kiện hiếm nên 60s là đủ
# INDEX_POLL_MS=60000
# (tuỳ chọn) SAU khi đã tích hợp: giãn W1/W2 (canh tích hợp) còn mức này để nhẹ tải;
# W3 (on-chain) + scanIndexTokens (API) VẪN chạy mỗi INDEX_POLL_MS để bắt token nhanh. Mặc định 10 phút.
# INDEX_W12_SLOW_MS=600000
# (tuỳ chọn) đổi nguồn nếu cần
# THEINDEX_APP_JS=https://indices.theindex.finance/app.js
# THEINDEX_ASSETS=https://indices.theindex.finance/api/assets
# POOLSTRADE_BASE=https://pools.trade
# (W3 on-chain) launcher pools.trade (bonding-curve) — đổi nếu pools.trade thay contract
# POOLSTRADE_LAUNCHER=0x23f8209572b4a1C2AD88A42749E830791Fb027f1
# (W3) lần đầu quét lùi bao nhiêu block (mặc định 2000000 ~ nhanh, không rate-limit)
# INDEX_ONCHAIN_LOOKBACK=2000000
# (W3) hoặc ép block bắt đầu cụ thể; =0 để quét TOÀN lịch sử (NẶNG, dễ 429 — chỉ khi cần)
# INDEX_ONCHAIN_FROM=0
# W3 dùng chung RPC_URLS + CONFIRMATIONS ở trên (RPC failover + dự phòng Blockscout).

