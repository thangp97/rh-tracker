# EasyA/Kickstart tracker — copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# ĐỪNG commit .env. Bot cần Node >= 18.

# Helius (RPC + websocket). Free tier đủ dùng: https://dashboard.helius.dev
HELIUS_API_KEY=your-helius-api-key

# (khuyên dùng) NHIỀU endpoint để FAILOVER (chống điểm chết đơn Helius). Cách nhau dấu phẩy, ưu tiên
# hơn HELIUS_API_KEY. wsEndpoint tự suy ra (https->wss). Ví dụ ghép 2 key Helius + 1 RPC công khai:
#   SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=KEY1,https://mainnet.helius-rpc.com/?api-key=KEY2,https://api.mainnet-beta.solana.com
# Bot xoay endpoint khi RPC lỗi và khi websocket "im lặng" quá lâu (onSlotChange là nhịp tim).

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-from-BotFather
# Nhắn cho bot 1 câu, rồi đọc chat id ở: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789

# (tuỳ chọn) link launchpad hiện trong thẻ dạng {KICKSTART_BASE}{mint}. Bỏ trống -> chỉ hiện Solscan.
# KICKSTART_BASE=https://www.kickstart.fun/token/

# (tuỳ chọn) chu kỳ heartbeat 💓 (giờ, mặc định 6)
# HEARTBEAT_HOURS=6

# (nâng cao) địa chỉ dùng làm mentions-filter để bắt launch. Mặc định = co-signer EasyA (ký mọi launch,
# bền qua khi EasyA đổi config account). CHỈ đặt biến này nếu EasyA đổi luôn ví co-signer sau này —
# dán địa chỉ mới vào đây là bot bắt lại, KHÔNG cần sửa/deploy code.
# EASYA_WATCH=HtrbuJZV5K6FTbrMCxuWXoeEC1V5NwsqiToXtqtZVtxQ
